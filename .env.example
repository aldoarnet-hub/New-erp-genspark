# ========================================
# AMBIENTE
# ========================================
NODE_ENV=development

# ========================================
# BACKEND
# ========================================
BACKEND_PORT=3001
API_PREFIX=/api/v1

# ========================================
# BANCO DE DADOS
# ========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=erp_dev
DATABASE_SCHEMA=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp_dev
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=true

# ========================================
# REDIS
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ========================================
# RABBITMQ
# ========================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://localhost:5672

# ========================================
# JWT
# ========================================
JWT_SECRET=erp-saas-construcao-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=erp-saas-construcao-refresh-secret-key-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ========================================
# CRIPTOGRAFIA
# ========================================
ENCRYPTION_KEY=erp-saas-encryption-key-32-chars!

# ========================================
# AWS (opcional)
# ========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ========================================
# CORS
# ========================================
CORS_ORIGIN=http://localhost:5175

# ========================================
# FRONTEND
# ========================================
VITE_API_URL=http://localhost:3001
VITE_API_PREFIX=/api/v1
VITE_APP_NAME=ERP Construcao
VITE_APP_VERSION=1.0.0
VITE_ENABLE_MOCKS=false
